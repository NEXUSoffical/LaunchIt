# LaunchIt TikTok Bot Configuration

# The TikTok handle of your bot account (without the @)
TIKTOK_BOT_HANDLE=launchit.world

# Your TikTok sessionid cookie (from browser DevTools > Application > Cookies > sessionid)
TIKTOK_SESSION_COOKIE=your_sessionid_here

# Solana RPC Endpoint
SOLANA_RPC_URL=https://api.devnet.solana.com
